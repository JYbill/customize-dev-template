pipeline {
    agent {
        node {
            label ''
            customWorkspace "workspace/微助教/${branch}"
        }
    }


    stages {
        stage('Init') {
            steps {
                echo "执行节点：${env.NODE_NAME}"
                echo "执行器编号：${env.EXECUTOR_NUMBER}"
                echo "工作目录：${env.WORKSPACE}"
                script {
                    def hostName = isUnix()
                        ? sh(script: 'hostname', returnStdout: true).trim()
                        : bat(script: '@hostname', returnStdout: true).trim()
                    echo "主机名：${hostName}"
                }
            }
        }

        stage('git clone') {
            steps {
                git branch: branch, credentialsId: 'github-wzj-nodejs-v2-deploy-pk', url: 'git@github.com:whtthd/wzj-nodejs-v2.git'
            }
        }

        stage("collect changed files") {
            steps {
                script {
                    def checkFiles = getGithubCommitFiles()
                    env.CHECK_FILES = checkFiles.join(' ')
                    env.RUN_CHECKS = checkFiles ? 'true' : 'false'
                }
            }
        }

        stage("install env") {
            steps {
                script {
                    def envPath = "${env.WORKSPACE}/env"
                    sh "mkdir -p '${envPath}'"
                    sh "curl -fSL -o '${envPath}/.env' 'http://192.168.88.234/env-share/wzj-nodejs-v2/wzj/env.txt'"
                    sh "rm -f '${envPath}/.development.env' '${envPath}/.production.env'"
                    sh "touch '${envPath}/.development.env' '${envPath}/.production.env'"
                }
            }
        }

        stage('install') {
            steps {
                sh "docker build --progress=plain -f '${platform}.Dockerfile' --target install ."
            }
        }

        stage("lint & format") {
            steps {
                script {
                    if (env.RUN_CHECKS == 'true') {
                        sh "docker build --progress=plain --build-arg CHECK_FILES='${env.CHECK_FILES}' -f '${platform}.Dockerfile' --target format ."
                        sh "docker build --progress=plain --build-arg CHECK_FILES='${env.CHECK_FILES}' -f '${platform}.Dockerfile' --target lint ."
                    } else {
                        echo '没有需要检查的 TS 文件，跳过 lint 和 format'
                    }
                }
            }
        }

        stage("build") {
            steps {
                script {
                    def dockerImageName = "backend-wzj-nodejs-v2"
                    def branchName = sh(script: "git branch --show-current", returnStdout: true).trim().replace("/", "_")
                    def commitId = sh(script: "git rev-parse --short=10 HEAD", returnStdout: true).trim()
                    def gitTag = sh(script: "git describe --tags --abbrev=0", returnStdout: true).trim()
                    def dockerTag = "${platform == 'x86-debian' ? 'x86' : 'arm'}_${branchName}_${commitId}_${gitTag}"
                    
                    env.DOCKER_IMAGE_NAME = dockerImageName
                    env.DOCKER_TAG = dockerTag
                    // 本地镜像按任务和构建号区分，避免两条流水线互相覆盖。
                    env.LOCAL_IMAGE = "${dockerImageName}:${dockerTag}-wzj-${env.BUILD_NUMBER}"
                    sh "docker build --progress=plain -f '${platform}.Dockerfile' --target production -t ${env.LOCAL_IMAGE} ."
                }
            }
        }

        stage("docker push 115 nexus") {
            steps {
                script {
                  withCredentials([usernamePassword(
                    credentialsId: 'nexus-155-user-pwd',
                    usernameVariable: 'username',
                    passwordVariable: 'password'
                  )]) {
                    sh 'docker login --username=$username --password=$password 192.168.88.115:8082'
                    sh "docker tag ${env.LOCAL_IMAGE} 192.168.88.115:8082/${env.DOCKER_IMAGE_NAME}:${env.DOCKER_TAG}"
                    sh "docker push 192.168.88.115:8082/${env.DOCKER_IMAGE_NAME}:${env.DOCKER_TAG}"
                  }
                }
            }
        }


        stage("ssh deploy") {
            steps {
                script {
                  // 允许部署的分支
                  def allowDeployBranchList = ['merge/wzj-temp']
                  if (!allowDeployBranchList.contains(branch)) { return }

                  // arm版本禁止部署
                  if (platform == 'arm') { return }

                  def remote = [:]
                  remote.name = '内网234'
                  remote.host = '192.168.88.234'
                  remote.allowAnyHosts = true

                  withCredentials([sshUserPrivateKey(
                    credentialsId: '234_ssh_pk',
                    usernameVariable: 'userName',
                    keyFileVariable: 'identity'
                  )]) {
                    remote.user = userName
                    remote.identityFile = identity
                    sshCommand remote: remote, command: """
                      cd /home/data/wzj/wzj-nodejs-v2
                      sed -i 's/${env.DOCKER_IMAGE_NAME}.*/${env.DOCKER_IMAGE_NAME}:${env.DOCKER_TAG}/' docker-compose.yaml
                      docker compose up -d
                    """
                  }
                }
            }
        }
    }

    post {
      success {
          script {
              setBuildStatus("Build complete", "SUCCESS")
          }
      }
      failure {
          script {
              setBuildStatus("Build failed", "FAILURE")
          }
      }
    }
}

void setBuildStatus(String message, String state) {
    step([
        $class: "GitHubCommitStatusSetter",
        reposSource: [$class: "ManuallyEnteredRepositorySource", url: "https://github.com/whtthd/wzj-nodejs-v2"],
        contextSource: [$class: "ManuallyEnteredCommitContextSource", context: "jenkins/wzj-nodejs-v2"],
        errorHandlers: [[$class: "ChangingBuildStatusErrorHandler", result: "UNSTABLE"]],
        statusResultSource: [ $class: "ConditionalStatusResultSource", results: [[$class: "AnyBuildResult", message: message, state: state]] ]
    ]);
}

def getGithubCommitFiles() {
    def webhookPayload = [:]

    // Generic Webhook Trigger 中配置 body = $，并勾选 Avoid flattening branches。
    if (env.body?.trim()) {
        webhookPayload = new groovy.json.JsonSlurperClassic().parseText(env.body)
    }

    def webhookCommits = webhookPayload instanceof Map ? (webhookPayload.commits ?: []) : []
    def changedFiles = webhookCommits instanceof List
        ? webhookCommits.collectMany { commit -> (commit.added ?: []) + (commit.modified ?: []) }
        : []

    if (changedFiles.isEmpty()) {
        echo "未从 Generic Webhook Trigger body.commits 获取到变更文件，回退提取最近 15 个 commit 的文件列表。"
        def recentCommitFiles = sh(
            script: "git -c core.quotepath=false log -15 --name-only --pretty=format: --diff-filter=ACMR | awk 'NF' | sort -u",
            returnStdout: true
        ).trim()
        changedFiles = recentCommitFiles ? recentCommitFiles.readLines() : []
    } else {
        echo "已从 Generic Webhook Trigger body.commits 获取变更文件。"
    }

    def sourceFiles = changedFiles
        .collect { "${it ?: ''}" }
        .findAll { it.startsWith('src/') && it ==~ '.*\\.[cm]?tsx?$' }
    def unsupported = sourceFiles.findAll { !(it ==~ '^src/[A-Za-z0-9_./-]+\\.[cm]?tsx?$') }
    if (unsupported) {
        error('变更含当前 CHECK_FILES 接口不支持的源码文件名；请调整文件名或检查脚本，不能静默漏检。')
    }
    def checkFiles = sourceFiles.unique().sort().findAll { fileExists(it) }

    echo "变更文件数：${changedFiles.size()}，待检查文件数：${checkFiles.size()}"
    return checkFiles
}
